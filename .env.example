# PostgreSQL connection string, ví dụ:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres
DATABASE_URL=

# Port cho backend API (mặc định 3000, frontend Vite sẽ proxy /api/* sang port này)
PORT=3000

# Kế hoạch năm: KHÔNG còn hardcode - đã chuyển vào DB
# Bảng chi_tieu_kpi (server/migrations/002_excel_redesign_chi_tieu_kpi.sql)
# Chứa KeHoachNam cho từng MaChiTieu/ Nam. Sửa bằng SQL:
# UPDATE chi_tieu_kpi SET ke_hoach_nam=20000 WHERE ma_chi_tieu='san_luong_than' AND nam=2026;
# Xem: SELECT * FROM v_tong_quan_kpi WHERE nam=2026;

# ── n8n Webhook (Task 3) ──────────────────────────────────────
# Frontend mặc định gọi /api/nhap-bao-cao (proxy qua backend để tránh CORS).
# Backend sẽ forward tới URL thực tế lấy từ N8N_WEBHOOK_URL (server) hoặc VITE_N8N_WEBHOOK_URL (client).
# Để dùng n8n thật, đổi 2 dòng dưới thành URL n8n của bạn:
# Ví dụ n8n cloud: https://your-n8n.app.n8n.cloud/webhook/nhap-bao-cao
# Ví dụ local: http://localhost:5678/webhook/nhap-bao-cao
# File bạn gửi có webhook path = nhap-bao-cao, webhookId = 29ae5a01-339e-4fc9-acd3-a46d3b049818
N8N_WEBHOOK_URL=https://n8n-proxy.manhtoan7620005.workers.dev/webhook/nhap-bao-cao
VITE_N8N_WEBHOOK_URL=
VITE_N8N_OVERVIEW_URL=/api/tong-quan
# Nếu Cloudflare Worker CORS đang chặn localhost, để trống VITE_N8N_WEBHOOK_URL để dùng /api/nhap-bao-cao
