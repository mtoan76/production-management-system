# PostgreSQL connection string, ví dụ:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres
DATABASE_URL=

# Port cho backend API (mặc định 3000, frontend Vite sẽ proxy /api/* sang port này)
PORT=3000

# Mục tiêu cả năm cho 4 loại chỉ số chính (dùng để tính % kế hoạch)
# Sản lượng (lo_cho): tấn/năm
KE_HOACH_SAN_LUONG=1000000
# Đào lò (dao_lo): mét/năm
KE_HOACH_DAO_LO=12000
# Xén lò (xen_lo): mét/năm
KE_HOACH_XEN_LO=6000
# Chống đội (chong_doi): mét/năm
KE_HOACH_CHONG_DOI=6000
